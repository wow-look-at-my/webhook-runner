{
  "description": "Deploy the frontend on push to main",
  "image": "alpine:3.20",
  "command": ["sh", "-c", "echo 'deploying with payload at $HOOK_PAYLOAD_FILE'; cat $HOOK_PAYLOAD_FILE | head -c 200"],
  "env": {
    "DEPLOY_TARGET": "production"
  },
  "timeout": "10m",
  "secret": "whsec_replace_me",
  "signature_header": "X-Hub-Signature-256",
  "github_status": {
    "enabled": true,
    "context": "webhook-runner/deploy-frontend",
    "target_url": "https://hooks.example.com/runs/{{.RunID}}"
  }
}
