{
  "$schema": "https://sites.pazer.build/webhook-runner/branch/master/hook.schema.json",
  "description": "Deploy the frontend on push to main",
  // The work lives in deploy.sh, baked into the image. `command` is argv, not
  // a shell program: nested command substitution is refused at load and by
  // the schema.
  "command": ["sh", "deploy.sh"],
  "settings": {
    "deploy_target": "production"
  },
  "timeout": "10m",
  "api_key": "replace-me-with-a-real-key",
  "github_status": {
    "enabled": true,
    "context": "webhook-runner/deploy-frontend",
    "target_url": "https://hooks.example.com/runs/{{.RunID}}"
  }
}
