{
  "$schema": "https://sites.pazer.build/webhook-runner/branch/master/hook.schema.json",
  // Exercises sops secrets end to end: SECRET_MESSAGE is auto-injected from
  // secrets.sops.env into the container's environment, and the api_key itself
  // lives in the encrypted file (a ${NAME} reference resolved by the runner).
  // Decrypted with the committed test-only key at e2e/age-test-key.txt
  // (SOPS_AGE_KEY_FILE). Hook CONFIG does not live here -- that is `settings`.
  "command": ["sh", "-c", "echo msg=$SECRET_MESSAGE"],
  "api_key": "${SOPS_HOOK_KEY}",
  "timeout": "60s"
}
