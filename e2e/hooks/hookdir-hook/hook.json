{
  "image": "alpine:latest",
  "command": ["sh", "-c", "cat $HOOK_DIR/data.txt"],
  // Run by `webhook-runner test`: cwd is the HOOK_DIR mount, so relative
  // paths resolve to this directory.
  "tests": [
    ["sh", "-c", "test -f hook.json && test -f \"$HOOK_DIR/data.txt\" && echo hookdir-tests-ok"]
  ],
  "timeout": "60s"
}
