[Unit]
Description=Docker daemon for webhook-runner's disposable containers (store on the pool)
Documentation=https://github.com/wow-look-at-my/webhook-runner/blob/master/deploy/pool-daemon/README.md
After=network-online.target zfs-mount.service
Wants=network-online.target
# The store lives on the pool, so the pool must be mounted first. Without this
# a boot race starts dockerd against an EMPTY mountpoint, and it happily
# creates its store on the underlying root filesystem — the exact disk this
# daemon exists to keep out of.
RequiresMountsFor=/mnt/pool

[Service]
Type=notify
ExecStart=/usr/bin/dockerd --config-file /etc/docker/pool-daemon.json
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=2
# dockerd's own recommended limits (mirrors the stock docker.service).
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=process
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
